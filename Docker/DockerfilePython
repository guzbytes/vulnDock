# Use the official Python image
ARG WEB_VERSION=3-slim
FROM python:${WEB_VERSION}

# Set the working directory in the container
WORKDIR /app

# Copy the requirements file and app code
COPY ../PythonWebApp/ ./PythonWebApp

# Install dependencies
RUN pip install --no-cache-dir -r ./PythonWebApp/requirements.txt

# Copy the contents of Frontend to the 'public' folder inside the container (without the folder itself)
COPY ../Frontend/public ./PythonWebApp/public

# Expose port 80 (same as in Flask)
EXPOSE 80

# Define the command to run the application with Gunicorn
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:80", "PythonWebApp.app:app"]
# Windows Image node JS
FROM mcr.microsoft.com/windows/servercore:ltsc2019 AS download

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ARG WEB_VERSION=20.8.1
ENV WEB_VERSION=$WEB_VERSION
RUN Invoke-WebRequest $('https://nodejs.org/dist/v{0}/node-v{0}-win-x64.zip' -f $env:WEB_VERSION) -OutFile 'node.zip' -UseBasicParsing ; \
    Expand-Archive node.zip -DestinationPath C:\ ; \
    Rename-Item -Path $('C:\node-v{0}-win-x64' -f $env:WEB_VERSION) -NewName 'C:\nodejs'

FROM  mcr.microsoft.com/windows/servercore:ltsc2019 AS target

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ENV NPM_CONFIG_LOGLEVEL=info
ENV PATH="C:\\nodejs;${PATH}"

COPY --from=download /nodejs /nodejs


# Copy files for installation and install dependencies
WORKDIR C:\\app
COPY NodeJSWebapp/package*.json ./

RUN ["C:\\nodejs\\node.exe", "C:\\nodejs\\node_modules\\npm\\bin\\npm-cli.js", "install", "--omit=dev"]

COPY NodeJSWebapp/ C:\\app
COPY Frontend/ C:\\app

EXPOSE 80
CMD [ "C:\\nodejs\\node.exe" , "C:\\app\\app.js" ]
ARG DB_VERSION=5.7
FROM mysql:${DB_VERSION}

# Environment variables to configure MySQL
ENV MYSQL_ROOT_PASSWORD=root
ENV MYSQL_DATABASE=web_app
ENV MYSQL_USER=app_user
ENV MYSQL_PASSWORD=app_password

# Disable secure-file-priv to allow LOAD DATA INFILE
CMD ["mysqld", "--secure-file-priv="]

# Copy the SQL script for initialization in the appropriate folder
COPY ../database/mysql/create_tables.sql /docker-entrypoint-initdb.d/init.sql

# Expose port 3306
EXPOSE 3306

# Establecer la imagen base (usando el SDK de .NET para compilar la app)
ARG WEB_VERSION=8.0
FROM mcr.microsoft.com/dotnet/aspnet:${WEB_VERSION}-windowsservercore-ltsc2022  AS base
WORKDIR /app
EXPOSE 80

FROM mcr.microsoft.com/dotnet/sdk:${WEB_VERSION}-windowsservercore-ltsc2022  AS build
WORKDIR /src
COPY ["Docker/backend/ASPNETWebapp.csproj", "./"]
RUN dotnet restore "ASPNETWebapp.csproj"

# Copy the code 
COPY Docker/backend/. .
COPY Docker/frontend/public ./wwwroot/
WORKDIR "/src/"
# RUN dotnet clean
RUN dotnet build "ASPNETWebapp.csproj" -c Release -o /app/build

# Publicar la aplicación
FROM build AS publish
RUN dotnet publish "ASPNETWebapp.csproj" -c Release -o /app/publish

# Imagen final de la app (usando runtime de .NET)
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "ASPNETWebapp.dll"]

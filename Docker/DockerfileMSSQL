# Official Microsoft SQL Server 2022 image on Ubuntu
ARG DB_VERSION=2022-latest
FROM mcr.microsoft.com/mssql/server:${DB_VERSION}

# Environment variables required by the image
ENV SA_PASSWORD=YourStrong!Passw0rd
ENV ACCEPT_EULA=Y
ENV MSSQL_PID=Express

USER root
# Install necessary tools for sqlcmd
RUN apt-get update && \
    apt-get install -y curl gnupg apt-transport-https && \
    curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add - && \
    curl https://packages.microsoft.com/config/ubuntu/22.04/prod.list > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y mssql-tools unixodbc-dev && \
    echo 'export PATH="$PATH:/opt/mssql-tools/bin"' >> ~/.bashrc && \
    ln -sfn /opt/mssql-tools/bin/sqlcmd /usr/bin/sqlcmd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists

# Copy the SQL script to initialize the database
COPY ../database/mssql/create_tables.sql /init.sql

# Expose the default MSSQL port
EXPOSE 1433

# Startup script that waits for the server to be ready and executes the SQL
CMD /bin/bash -c "\
    /opt/mssql/bin/sqlservr & \
    echo 'Waiting for SQL Server to start...' && sleep 20 && \
    /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P '$SA_PASSWORD' -Q 'CREATE DATABASE web_app' && \
    /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P '$SA_PASSWORD' -d web_app -i /init.sql && \
    tail -f /dev/null"

ARG WEB_VERSION=21
FROM maven:3.9.6-eclipse-temurin-21 AS build

# Set the working directory where the app will be built
WORKDIR /build

# Copy the necessary files to build
COPY ../JavaWebapp/app/pom.xml .

# Download dependencies first for better caching
RUN mvn dependency:go-offline

# Now copy the source code and build the application
COPY ../JavaWebapp/app/src ./src
RUN mvn clean package -DskipTests
FROM eclipse-temurin:${WEB_VERSION}-jre-jammy

# Install the `ping` command
RUN apt-get update && apt-get install -y iputils-ping && rm -rf /var/lib/apt/lists/*

# Set the working directory in the final container
WORKDIR /app

# Copy the .jar from the build image
COPY --from=build /build/target/app-0.0.1-SNAPSHOT.jar app.jar
COPY ../Frontend/ .

# Expose the default Spring Boot port
EXPOSE 80

# Run the app
ENTRYPOINT ["java", "-jar", "app.jar"]
